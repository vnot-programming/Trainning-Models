# .agentignore - Daftar file/folder yang dilarang diakses oleh agents

# File sensitif & kredensial
*.env
*.key
*.pem
*.p12
*.pfx
rclone.conf
**/rclone.conf
**/.vscode-server/data/User/settings.json
**/.ssh/*
**/secrets/*
**/credentials*

# File binary & data besar
*.pt
*.pth
*.weights
*.onnx
*.pb
**/data-files/**/*.csv
**/runs/**/weights/*
**/models/*

# File sementara & cache
__pycache__/
*.pyc
*.pyo
node_modules/
.cache/
**/.vscode-server/data/User/workspaceStorage/*

# Log files
*.log
**/debug-logs/*

# File konfigurasi privat
*.local.yaml
*.secret.yaml

# Large datasets (images)
**/datasets/**/*.jpg
**/datasets/**/*.png
**/datasets/**/*.txt

# Training outputs (large files)
**/data-files/**/*.csv
**/data-files/**/image_samples/*
**/data-files/**/visuals/*
