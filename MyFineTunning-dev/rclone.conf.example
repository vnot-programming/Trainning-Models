# ==============================================================================
# rclone.conf.example — Template Konfigurasi Rclone untuk Google Drive
# ==============================================================================
# CARA PAKAI:
#   1. Salin file ini: cp rclone.conf.example rclone.conf
#   2. Konfigurasi rclone: rclone config
#   3. Atau tambahkan token manual (tidak disarankan untuk production)
#   4. JANGAN commit file ini ke Git (sudah di-exclude via .gitignore)
# ==============================================================================

# ------------------------------------------------------------------------------
# GOOGLE DRIVE — Konfigurasi remote untuk backup
# ------------------------------------------------------------------------------
[gdrive]
type = drive
scope = drive
token = {"access_token":"YOUR_ACCESS_TOKEN_HERE","token_type":"Bearer","refresh_token":"YOUR_REFRESH_TOKEN_HERE","expiry":"YOUR_EXPIRY_TIME_HERE","expires_in":3599}
team_drive =

# ------------------------------------------------------------------------------
# CONTOH PENGGUNAAN:
#   rclone copy local_folder gdrive:backup_folder
#   rclone ls gdrive:
#   rclone delete gdrive:old_folder
# ------------------------------------------------------------------------------